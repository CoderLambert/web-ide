{
  "name": "web-ide",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vp build",
    "build:sql-grammar": "node scripts/build-sql-grammar.mjs",
    "verify:sql-grammar": "pnpm build:sql-grammar && git diff --exit-code -- public/languages/sql/tree-sitter-sql.wasm",
    "preview": "vp preview",
    "start:s0:lsp-mock": "node scripts/s0-lsp-jsonrpc-server.mjs",
    "test:unit": "vp test run tests/unit",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "check": "vp check",
    "test": "playwright test",
    "test:s0:lsp": "playwright test tests/s0/lsp-jsonrpc.spec.ts",
    "test:s0:monaco": "playwright test tests/s0/monaco-lifecycle.spec.ts",
    "test:s0:sql-parse": "playwright test tests/s0/sql-parse.spec.ts",
    "test:s0:sql-grammar": "playwright test tests/s0/sql-grammar-load.spec.ts",
    "test:s0:tree-sitter": "playwright test tests/s0/tree-sitter-runtime.spec.ts",
    "verify:s0": "node scripts/verify-s0.mjs"
  },
  "dependencies": {
    "@codingame/monaco-vscode-api": "25.1.2",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "monaco-editor": "0.55.1",
    "monaco-languageclient": "10.7.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vscode-ws-jsonrpc": "3.5.0",
    "web-tree-sitter": "0.25.10",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.167.33",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.62.1",
    "tree-sitter-cli": "0.25.10",
    "typescript": "^6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  }
}
